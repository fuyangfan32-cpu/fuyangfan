# 云端生成模型：兼容 OpenAI Chat Completions 的接口均可
MODEL_PROVIDER=cloud
CLOUD_API_BASE=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini

# Ollama 本地生成模式：将 MODEL_PROVIDER 改为 ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# 向量检索可选。未配置时自动使用 Supabase/本地关键词检索
EMBEDDING_PROVIDER=none
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Supabase 只在后端使用 service_role key，绝对不要写进前端
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,https://fuyangfan32-cpu.github.io
REQUESTS_PER_HOUR=40
